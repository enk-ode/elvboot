# publish-sync.sh sweep: one extended regex per line; hits abort the sync.
# Core patterns (private IPv4 ranges, private key blocks) are built in.
# Add machine-specific identifiers here as they appear, e.g.:
#   [0-9A-F]{4} ?F9E67735        # a card serial
illyria-works
# dated or attributed working remarks in texts (the notes stay outside the tree)
\(JB [0-9]
JB [0-9]{1,2}\.[0-9]{2}\.
illyria [0-9]{2}\.[0-9]{2}\.
# tracked file names never published (in addition to the built-in DESIGN_/REVIEW/Import rule)
path:^docs/TEST-
