xargs sh -c '[ "$0" = "--" ] || set -- "$0" "$@"; lit=$(printf "\044ELEBAKE_CONTEXT_SCRIPT"); n=$#; while [ $n -gt 0 ]; do a=$1; shift; [ "$a" = "$lit" ] && a=$ELEBAKE_CONTEXT_SCRIPT; set -- "$@" "$a"; n=$((n-1)); done; exec "$@"' --
# Interpreter for 'restore replay' - execs the one line the combinator
# emits. Keep-going and the archive base stand IN that line (env
# ELEBAKE_BATCH_KEEP_GOING=1 ELEBAKE_ARCHIVE_BASE=... "$ELEBAKE_CONTEXT_SCRIPT"
# batch <dump>) since 15.09., so a reader of the emission sees both and a
# runner in one process (elebake-binary.sh) applies them as prefix
# assignments of its own call.
#
# The words are exec'd as xargs split them, NOT eval'd -- an eval would
# re-split a quoted error reason into many arguments. Only the one word
# that is the literal $ELEBAKE_CONTEXT_SCRIPT (printf \044 spells the
# dollar sign without putting one into this template) is mapped to the
# script path, wherever it stands: restore's line starts with env, so the
# combinator default (expand $1) cannot serve it. Set to cat for a dry-run.
