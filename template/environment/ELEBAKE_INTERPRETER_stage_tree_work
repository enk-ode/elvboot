env ELEBAKE_BATCH_KEEP_GOING=0 sh -c 'tmp=$(mktemp "$ELEBAKE_BASE/.tmp/batch.XXXXXX"); chmod 0600 "$tmp"; cat > "$tmp"; exec "$ELEBAKE_CONTEXT_SCRIPT" batch "$tmp" true'
# @summary Interpreter for the batch `stage tree work` -- fail-fast core of tree sync
# snapshot, copy, verify: the first failing step stops this batch. The
# wrapper forces keep-going OFF because the enclosing `stage tree sync`
# turned it on, and children inherit the environment.
# @see ELEBAKE_INTERPRETER_stage_tree_sync
