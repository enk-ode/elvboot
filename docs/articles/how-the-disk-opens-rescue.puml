@startuml
hide footbox
participant O
participant L
participant C
participant K
L -> O : rescue root? (y/N)
O -> L : y
O -> L : unlock passphrase
L -> L : PBKDF2 == compiled hash
L -> L : note root, key file
L -> C : load rescue key file
C --> L : key file (preloaded)
O -> L : rescue passphrase
L -> C : read last sectors
C --> L : GELI metadata
L -> L : PBKDF2(passphrase)
L -> L : HMAC(key file, PBKDF2)
L -> L : master key verifies
L -> L : root = rescue, read-only
L -> K : user key, key file
K -> C : attach, read-only
@enduml
